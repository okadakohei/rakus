# .env.example
# このファイルをコピーして .env を作成し実際の値を入力してください
# .env は .gitignore に追加して絶対に GitHub に push しないこと

# 運用モード: PAPER または LIVE
TRADING_MODE=PAPER

# 取引所選択
CRYPTO_EXCHANGE=zaif
FX_BROKER=oanda

# OANDA API(デモ口座で開始)
OANDA_API_TOKEN=your_oanda_api_token_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

# ZAIF API(LIVE モード時のみ必要)
ZAIF_API_KEY=your_zaif_api_key_here
ZAIF_API_SECRET=your_zaif_api_secret_here

# 全滅通知メール(Gmail 等 SMTP 対応サービス)
NOTIFY_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here

# GitHub 自動バックアップ用(git remote add origin <URL> で設定済みであれば不要)
GITHUB_REPO_URL=https://github.com/yourusername/trading-agent.git
